{
  "name": "thai-font-studio-illustrator",
  "version": "2.0.0",
  "description": "Adobe Illustrator CEP panel for designing Thai/Latin OpenType fonts",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "test": "node tests/run.js",
    "stamp": "node scripts/stamp.js",
    "vendor": "node scripts/vendor.js",
    "package": "node scripts/package.js",
    "golden-update": "node tests/compile-test.js --update",
    "build-font": "node tests/build-test.js",
    "check-font": "python3 tests/check_font.py",
    "screens": "node tests/screens.js",
    "auto-screens": "node tests/auto-screens.js"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "playwright": "^1.40.0"
  },
  "engines": {
    "node": ">=18"
  }
}
