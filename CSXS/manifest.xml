<?xml version="1.0" encoding="UTF-8"?>
<!--
  Thai Font Studio — CEP extension manifest
  CSXS 9.0 = Illustrator CC 2019 (v23) ขึ้นไป  (CS6 – CC 2018 ใช้ไม่ได้ เพราะไม่มี CEP 9)
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.thaifontstudio.illustrator" ExtensionBundleVersion="2.0.0"
    ExtensionBundleName="Thai Font Studio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.thaifontstudio.illustrator.panel" Version="2.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[23.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.thaifontstudio.illustrator.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./hostScript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Thai Font Studio</Menu>
                    <Geometry>
                        <Size><Height>760</Height><Width>360</Width></Size>
                        <MinSize><Height>420</Height><Width>300</Width></MinSize>
                        <MaxSize><Height>1600</Height><Width>900</Width></MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon-24.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-24.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
